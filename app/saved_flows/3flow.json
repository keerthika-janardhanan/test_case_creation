{
    "flow_name": "3flow",
    "source": "playwright",
    "steps": [
        {
            "action": "goto",
            "url": "https://example.com/"
        },
        {
            "action": "click",
            "selector": "await page.getByRole('link', { name: 'More information...' })"
        },
        {
            "action": "click",
            "selector": "await page.getByRole('link', { name: 'IANA-managed Reserved Domains' })"
        },
        {
            "action": "click",
            "selector": "await page.getByRole('link', { name: 'RFC 2606' })"
        },
        {
            "action": "click",
            "selector": "await page.getByRole('link', { name: '1', exact: true }).nth(1)"
        },
        {
            "action": "click",
            "selector": "await page.getByRole('link', { name: 'RFC 1035' })"
        }
    ]
}